# Asmeranda AI — Environment Variables
# Salin file ini ke .env dan sesuaikan nilainya.
#
# cp .env.example .env
# (atau di Windows: copy .env.example .env)

# ─── Backend Configuration ────────────────────────────────────────────────────

# Host dan port server FastAPI
ASMERANDA_HOST=0.0.0.0
ASMERANDA_PORT=8000

# Level logging: DEBUG | INFO | WARNING | ERROR
ASMERANDA_LOG_LEVEL=INFO

# Mode debug (menampilkan stack trace di response API)
ASMERANDA_DEBUG=false

# Direktori penyimpanan dataset yang di-upload
ASMERANDA_DATA_DIR=./data

# Ukuran maksimum upload file (MB)
ASMERANDA_MAX_UPLOAD_SIZE_MB=200

# CORS: daftar origin yang diizinkan (format JSON array)
# Development: ["http://localhost:3000"]
# Production Vercel: ["https://asmeranda.vercel.app"]
ASMERANDA_CORS_ORIGINS=["http://localhost:3000"]

# JWT Secret — WAJIB diganti di production!
ASMERANDA_JWT_SECRET=change-me-in-production-use-a-long-random-string
ASMERANDA_JWT_ALGORITHM=HS256
ASMERANDA_JWT_EXPIRE_MINUTES=1440

# ─── Frontend Configuration ───────────────────────────────────────────────────

# URL backend yang diakses oleh browser (untuk Next.js rewrites)
# Development lokal: http://localhost:8000
# Docker Compose:    http://backend:8000  (nama service Docker)
# Production:        https://your-backend.railway.app
NEXT_PUBLIC_API_BASE=http://localhost:8000
