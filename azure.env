# Asmeranda AI - Azure Container App environment variables.
# Sumber: Azure CLI `az containerapp create --env-vars-file azure.env`
# atau `az containerapp update --set-env-vars ...`

# ----------------------------------------------------------------------------
# Backend (FastAPI)
# ----------------------------------------------------------------------------
ASMERANDA_HOST=0.0.0.0
ASMERANDA_PORT=8000
ASMERANDA_DATA_DIR=/app/data
ASMERANDA_LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
PYTHONPATH=/app

# ----------------------------------------------------------------------------
# Frontend (Next.js)
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_API_BASE_PATH=/api/v1

# ----------------------------------------------------------------------------
# Azure-specific (opsional)
# ----------------------------------------------------------------------------
# AZURE_BLOB_CONNECTION_STRING=
# APPLICATIONINSIGHTS_CONNECTION_STRING=
